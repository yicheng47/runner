[
  {
    "runtime": "claude-code",
    "spawn": {
      "env": {
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "CODEX_HOME": "<TMP>/.codex",
        "COLORTERM": "truecolor",
        "COPILOT_HOME": "<TMP>/.copilot",
        "DISABLE_INSTALLATION_CHECKS": "1",
        "PI_CODING_AGENT_DIR": "<TMP>/.pi/agent",
        "RUNNER_HANDLE": "tester",
        "RUNNER_HOOK_EXECUTABLE": "<TMP>/bin/runner",
        "RUNNER_HOOK_GENERATION": "<ID3>",
        "RUNNER_HOOK_SESSION": "<ID4>",
        "TERM": "xterm-256color"
      },
      "codex_pending_turn": null,
      "watcher": "claude-code",
      "interrupt": true,
      "key_capture": {
        "mechanism": "hook"
      },
      "rollout": null
    }
  },
  {
    "runtime": "codex",
    "spawn": {
      "env": {
        "CODEX_HOME": "<MATERIALIZER>/codex-home",
        "COLORTERM": "truecolor",
        "COPILOT_HOME": "<TMP>/.copilot",
        "PI_CODING_AGENT_DIR": "<TMP>/.pi/agent",
        "RUNNER_HANDLE": "tester",
        "RUNNER_HOOK_EXECUTABLE": "<TMP>/bin/runner",
        "RUNNER_HOOK_GENERATION": "<ID3>",
        "RUNNER_HOOK_SESSION": "<ID4>",
        "TERM": "xterm-256color"
      },
      "codex_pending_turn": false,
      "watcher": "codex",
      "interrupt": false,
      "key_capture": {
        "mechanism": "rollout-scan",
        "sessions_root": "<MATERIALIZER>/codex-home/sessions"
      },
      "rollout": null
    }
  },
  {
    "runtime": "pi",
    "spawn": {
      "env": {
        "CODEX_HOME": "<TMP>/.codex",
        "COLORTERM": "truecolor",
        "COPILOT_HOME": "<TMP>/.copilot",
        "PI_CODING_AGENT_DIR": "<TMP>/.pi/agent",
        "PI_SKIP_VERSION_CHECK": "1",
        "RUNNER_HANDLE": "tester",
        "RUNNER_HOOK_EXECUTABLE": "<TMP>/bin/runner",
        "RUNNER_HOOK_GENERATION": "<ID4>",
        "RUNNER_HOOK_SESSION": "<ID3>",
        "TERM": "xterm-256color"
      },
      "codex_pending_turn": null,
      "watcher": "pi",
      "interrupt": false,
      "key_capture": {
        "mechanism": "hook"
      },
      "rollout": null
    }
  }
]
