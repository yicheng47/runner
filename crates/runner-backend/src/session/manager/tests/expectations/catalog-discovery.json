      "runtime": "codex",
      "override_home": false,
      "supported": true,
      "source": {
        "command": "/golden/agent",
        "executable": null,
        "config_home": "<HOME>/.codex"
      },
      "commands": [
        {
          "command": "/golden/agent",
          "args": [
            "debug",
            "models"
          ],
          "env": {
            "GOLDEN_ENV": "value",
            "PATH": "/golden/bin:<DIRECT_CHAT_PATH>"
          },
          "cwd": "<HOME>",
          "stdin": null,
          "timeout_ms": 5000
        }
      ]
    },
