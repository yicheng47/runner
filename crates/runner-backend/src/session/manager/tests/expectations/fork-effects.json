[
  {
    "runtime": "claude-code",
    "spawn": {
      "env": {
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "CODEX_HOME": "<TMP>/.codex",
        "COLORTERM": "truecolor",
        "COPILOT_HOME": "<TMP>/.copilot",
        "DISABLE_INSTALLATION_CHECKS": "1",
        "PI_CODING_AGENT_DIR": "<TMP>/.pi/agent",
        "RUNNER_CLAUDE_STATUS_GENERATION": "<ID4>",
        "RUNNER_CLAUDE_STATUS_PATH": "<TMP>/session-status/<ID3>.ndjson",
        "RUNNER_HANDLE": "tester",
        "TERM": "xterm-256color"
      },
      "codex_pending_turn": null,
      "watcher": "claude-code",
      "interrupt": true,
      "key_capture": {
        "mechanism": "rekey-drop"
      },
      "rollout": null
    }
  },
  {
    "runtime": "codex",
    "spawn": {
      "env": {
        "CODEX_HOME": "<MATERIALIZER>/codex-home",
        "COLORTERM": "truecolor",
        "COPILOT_HOME": "<TMP>/.copilot",
        "PI_CODING_AGENT_DIR": "<TMP>/.pi/agent",
        "RUNNER_CODEX_STATUS_GENERATION": "<ID4>",
        "RUNNER_CODEX_STATUS_PATH": "<TMP>/session-status/<ID2>.ndjson",
        "RUNNER_HANDLE": "tester",
        "TERM": "xterm-256color"
      },
      "codex_pending_turn": false,
      "watcher": "codex",
      "interrupt": false,
      "key_capture": {
        "mechanism": "rollout-scan",
        "sessions_root": "<HOME>/.codex/sessions"
      },
      "rollout": null
    }
  },
  {
    "runtime": "pi",
    "spawn": {
      "env": {
        "CODEX_HOME": "<TMP>/.codex",
        "COLORTERM": "truecolor",
        "COPILOT_HOME": "<TMP>/.copilot",
        "PI_CODING_AGENT_DIR": "<TMP>/.pi/agent",
        "PI_SKIP_VERSION_CHECK": "1",
        "RUNNER_HANDLE": "tester",
        "RUNNER_PI_REKEY_PATH": "<TMP>/session-keys/<ID3>.json",
        "RUNNER_PI_SESSION_KEY": "<ID2>",
        "RUNNER_PI_STATUS_GENERATION": "<ID4>",
        "RUNNER_PI_STATUS_PATH": "<TMP>/session-status/<ID3>.ndjson",
        "TERM": "xterm-256color"
      },
      "codex_pending_turn": null,
      "watcher": "pi",
      "interrupt": null,
      "key_capture": {
        "mechanism": "rekey-drop"
      },
      "rollout": null
    }
  }
]
