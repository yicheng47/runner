#!/usr/bin/env python3
"""Build native Linux binaries and package one staged tree as tar.gz and deb."""
import argparse
import datetime
import os
from pathlib import Path
import platform
import shutil
import struct
import subprocess
import tarfile
import tempfile
import json

ROOT = Path(__file__).resolve().parent.parent
ARCHES = {'x86_64': ('amd64', 62), 'aarch64': ('arm64', 183)}


def run(*args, **kwargs):
    subprocess.run(args, check=True, **kwargs)


def verify_elf(path, arch):
    with path.open('rb') as binary:
        header = binary.read(20)
    if len(header) < 20 or header[:6] != b'\x7fELF\x02\x01' or struct.unpack('<H', header[18:20])[0] != ARCHES[arch][1]:
        raise SystemExit(f'{path} is not a Linux ELF64 executable for {arch}')


def normalize_package_permissions(root):
    # Package ownership alone does not remove a builder's group-writable umask.
    for path in [root, *root.rglob('*')]:
        if path.is_symlink():
            continue
        path.chmod(0o755 if path.is_dir() or path.stat().st_mode & 0o111 else 0o644)


def package_identity(version, channel, stamp, sha):
    label = version if channel == 'production' else f'{channel}.{sha[:7]}.{stamp}'
    metadata_channel = channel.replace('-', '.')
    deb_version = version if channel == 'production' else f'{version}~{metadata_channel}.{stamp}.{sha[:7]}'
    return label, deb_version


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--channel', choices=['production', 'nightly'], default='production')
    parser.add_argument('--arch', choices=ARCHES, default=platform.machine())
    parser.add_argument('--output-dir', type=Path, default=ROOT / 'target/linux-packages')
    parser.add_argument('--formats', default='tar,deb')
    args = parser.parse_args()
    if args.arch not in ARCHES:
        parser.error('Only Linux x86_64 and aarch64 are supported')
    formats = args.formats.split(',')
    if not formats or set(formats) - {'tar', 'deb'}:
        parser.error('--formats must select tar,deb')
    metadata = json.loads(subprocess.check_output(['cargo', 'metadata', '--locked', '--format-version', '1', '--no-deps'], cwd=ROOT))
    version = next(package['version'] for package in metadata['packages'] if package['name'] == 'runner-app').split('-')[0]
    stamp = os.environ.get('RUNNER_BUILD_STAMP', datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d.%H%M'))
    sha = os.environ.get('RUNNER_BUILD_SHA') or subprocess.check_output(['git', 'rev-parse', '--short=7', 'HEAD'], cwd=ROOT, text=True).strip()
    import re
    if not re.fullmatch(r'\d{8}\.\d{4}', stamp) or not re.fullmatch(r'[0-9a-fA-F]{7,40}', sha):
        parser.error('Invalid build stamp or SHA')
    label, package_version = package_identity(version, args.channel, stamp, sha)
    if platform.system() != 'Linux' or platform.machine() != args.arch:
        parser.error('Build and package on a native matching Linux host')
    target = f'{args.arch}-unknown-linux-gnu'
    env = dict(os.environ, RUNNER_BUILD_STAMP=stamp, RUNNER_BUILD_SHA=sha,
               RUNNER_RELEASE_CHANNEL=args.channel, RUNNER_MARKETING_VERSION=version if args.channel == 'production' else 'Nightly')
    # Always build both inputs with the production data namespace; never re-label prebuilt/debug bytes.
    run('cargo', '--config', 'profile.release.debug-assertions=false', 'build', '--locked', '--release',
        '--target', target, '-p', 'runner-app', '-p', 'runner-cli', cwd=ROOT, env=env)
    binary_dir = Path(metadata['target_directory']) / target / 'release'
    for name in ['Runner', 'runner-agent-cli']:
        verify_elf(binary_dir / name, args.arch)
    symbols = subprocess.check_output(['readelf', '--version-info', str(binary_dir / 'Runner'), str(binary_dir / 'runner-agent-cli')], text=True)
    glibc_versions = [tuple(map(int, value.split('.'))) for value in re.findall(r'\bGLIBC_(\d+(?:\.\d+)+)', symbols)]
    glibc = '.'.join(map(str, max([(2, 35), *glibc_versions])))
    cxx_versions = [tuple(map(int, value.split('.'))) for value in re.findall(r'\bGLIBCXX_(\d+(?:\.\d+)+)', symbols)]
    cxx = '.'.join(map(str, max(cxx_versions))) if cxx_versions else None
    deb_cxx = ''
    if cxx and 'deb' in formats:
        installed_cxx = subprocess.check_output(['dpkg-query', '-W', '-f=${Version}', 'libstdc++6'], text=True).strip()
        deb_cxx = f', libstdc++6 (>= {installed_cxx})'
    out = args.output_dir.resolve()
    out.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='runner-linux-', dir=out) as temp:
        temp = Path(temp)
        tree = temp / f'Runner-{label}-linux-{args.arch}'
        app = tree / 'lib/runner'
        app.mkdir(parents=True)
        for name in ['Runner', 'runner-agent-cli']:
            shutil.copy2(binary_dir / name, app / name)
            (app / name).chmod(0o755)
        shutil.copy2(app / 'runner-agent-cli', app / 'runnerd')
        (app / 'build-platform.txt').write_text(f'architecture={args.arch}\nglibc-minimum={glibc}\n' + (Path('/etc/os-release').read_text() if Path('/etc/os-release').exists() else ''))
        (app / 'install-layout-v1').write_text('runner-linux-package-v1\n')
        (app / 'release-info.json').write_text(json.dumps(dict(label=label, arch=args.arch, channel=args.channel, stamp=stamp, version=version)) + '\n')
        shutil.copy2(ROOT / 'script/linux/install.sh', app / 'install.sh')
        shutil.copy2(ROOT / 'script/linux/install.sh', tree / 'install.sh')
        for source, dest in [
            ('packaging/linux/runnerd.service', 'lib/systemd/user/runnerd.service'),
            ('packaging/linux/runner.desktop', 'share/applications/runner.desktop'),
            ('assets/icon.png', 'share/icons/hicolor/256x256/apps/runner.png'),
            ('assets/icon.png', 'lib/runner/icon.png'),
        ]:
            target = tree / dest
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(ROOT / source, target)
        normalize_package_permissions(tree)
        if 'tar' in formats:
            with tarfile.open(out / f'{tree.name}.tar.gz', 'w:gz') as archive:
                archive.add(tree, arcname=tree.name)
        stage = temp / 'package'
        shutil.copytree(tree / 'lib', stage / 'usr/lib', symlinks=True)
        shutil.copytree(tree / 'share', stage / 'usr/share')
        normalize_package_permissions(stage)
        aliases = (ROOT / 'packaging/linux/package-aliases.sh').read_text()
        deb_arch = ARCHES[args.arch][0]
        if 'deb' in formats:
            control = stage / 'DEBIAN'
            control.mkdir()
            for script, case, action in [
                ('preinst', 'install|upgrade', 'check'),
                ('postinst', 'configure|abort-upgrade|abort-remove|abort-deconfigure', 'install'),
                ('prerm', 'remove|deconfigure', 'remove'),
                ('postrm', 'remove|purge', 'remove'),
            ]:
                path = control / script
                path.write_text('#!/bin/sh\nset -eu\ncase "${1:-}" in ' + case + ') ;; *) exit 0 ;; esac\nset -- ' + action + '\n' + aliases)
                path.chmod(0o755)
            (control / 'control').write_text(f'''Package: runner
Version: {package_version}
Architecture: {deb_arch}
Maintainer: Runner maintainers <jason3gb@gmail.com>
Section: devel
Priority: optional
Depends: libc6 (>= {glibc}){deb_cxx}, libfontconfig1, libfreetype6, libxkbcommon0, libxkbcommon-x11-0, libwayland-client0, libwayland-cursor0, libwayland-egl1, libxcb1, libxcb-render0, libxcb-shape0, libxcb-xfixes0, libxcb-randr0, libxcb-xinput0, libxcb-cursor0, libegl1, libvulkan1, xdg-utils
Recommends: fonts-noto-cjk, xdg-desktop-portal, dbus-user-session
Description: Local desktop cockpit for CLI coding agents
 Native GPUI app, runner CLI and opt-in runnerd user service.
''')
            run('dpkg-deb', '--root-owner-group', '--build', str(stage), str(out / f'{tree.name}.deb'))
            shutil.rmtree(control)
    print(f'Packages: {out} ({args.arch}; {label})')


if __name__ == '__main__':
    main()
