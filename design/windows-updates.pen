        {
          "type": "text",
          "id": "t1214",
          "name": "spec_sub",
          "fill": "$text-2",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The hero card is the macOS layout: app icon, Runner + version chip, a one-line status, and the state's button on the right. Up to date shows Check for updates; every other state shows Update, which opens the centered update dialog. Progress never appears on the page.",
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
