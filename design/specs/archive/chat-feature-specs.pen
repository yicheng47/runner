          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "id": "iYQr9",
          "type": "ref",
          "ref": "tK5Xb",
          "name": "confirm_archive_stopped",
          "x": 756,
          "y": 100,
          "descendants": {
            "CucJL": {
              "icon": "archive",
              "fill": "#F87171"
            },
            "igS7I": {
              "content": "Archive chat?"
            },
            "FbcRk": {
