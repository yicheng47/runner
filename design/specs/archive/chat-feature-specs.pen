    {
      "type": "frame",
      "id": "OBtYk",
      "x": 21477,
      "y": 1693,
      "name": "Spec — GitHub Copilot CLI runtime (540) · v1",
      "clip": true,
      "width": 1500,
      "height": 1240,
      "fill": "$bg",
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "Mt8gt",
          "x": 24,
          "y": 20,
          "name": "spec_title",
          "fill": "$text-hi",
          "content": "Spec — GitHub Copilot CLI runtime (540) · v1",
          "fontFamily": "$font-ui",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "hPwpw",
          "x": 24,
          "y": 42,
          "name": "spec_sub",
          "fill": "$text-mid",
          "textGrowth": "fixed-width",
          "width": 1452,
          "content": "GitHub Copilot CLI (`copilot` 1.0.83) becomes the fourth agent runtime. Almost all of it reuses shipped surfaces — the Agents row, the runtime pickers, the permission dropdown, the Skills pane — so the only new pixels are the provider mark from #593 and the words on three existing controls. This frame shows the mark beside the three shipped marks, the rail before and after, the Agents row, the permission modes Copilot gets, and the tint decision. Probe evidence and the code inventory are in docs/features/540-copilot-cli-runtime.md.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "g6iI7G",
          "x": 24,
          "y": 100,
          "name": "cap_a",
          "fill": "$text-low",
          "content": "A · THE MARK — LOBE-ICONS githubcopilot.svg (MIT), ONE PATH, AT THE APP'S SIZES, BESIDE THE SHIPPED MARKS",
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
