                      ]
                    },
                    {
                      "type": "text",
                      "id": "NzLvc",
                      "name": "t2",
                      "fill": "$text-mid",
                      "content": "unread",
                      "fontFamily": "$font-ui",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "rectangle",
                      "id": "l1Tof",
                      "name": "drop",
                      "fill": "$accent",
                      "width": 28,
                      "height": 2
                    },
                    {
                      "type": "text",
                      "id": "TbIlz",
                      "name": "t3",
