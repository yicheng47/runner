        {
          "type": "text",
          "id": "SgHNl",
          "x": 812,
          "y": 288,
          "name": "note_b",
          "fill": "$text-mid",
          "textGrowth": "fixed-width",
          "width": 664,
          "content": "The card has the room the header lacks, so its subtitle shows the same detail the tooltip does: Working · Using tools, Working · Compacting context, or plain Working. The label keeps its weight and the detail is regular, as shipped on the 347 card. The mission tab strip and the sidebar stay at the glyph and the plain label. Anything longer than the line truncates with an ellipsis rather than growing the card.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
