                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A main-agent turn or an observed operation is active. Tooltip adds a verified detail: Working · Compacting context. Long silence during a healthy turn is normal.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
