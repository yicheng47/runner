          "textGrowth": "fixed-width",
          "width": 700,
          "content": "Confirm stops @coder, archives the chat, drops the pane; the split re-flows to one pane as today. Cancel changes nothing. The body's name is session_label, the same label the sidebar and the fork dialog use.",
          "lineHeight": 1.4,
          "fontFamily": "$font-ui",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "zC4u8",
