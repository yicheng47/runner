    {
      "type": "frame",
      "id": "x3miq",
      "x": 18240,
      "y": 1693,
      "name": "Spec — Terminal-provided titles (587) · v1",
      "clip": true,
      "width": 1500,
      "height": 1682,
      "fill": "$bg",
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "QGSF9",
          "x": 24,
          "y": 20,
          "name": "spec_title",
          "fill": "$text-hi",
          "content": "Spec — Terminal-provided titles (587) · v1",
          "fontFamily": "$font-ui",
          "fontSize": 14,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "x9Voi",
          "x": 24,
          "y": 42,
          "name": "spec_sub",
          "fill": "$text-mid",
          "textGrowth": "fixed-width",
          "width": 1452,
          "content": "The child already tells us what it is doing: Codex and friends write it over OSC 0/2, alacritty parses it, and Runner throws the string away. This spec spends it on the label — live while the pane runs, and in one nullable column beside it so the chat is still called something after a relaunch. A title never becomes status and never becomes identity, and the spinner frames that arrive ten times a second are stripped before the text is shown, because the spinner is #347's job and the words are ours.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "VfsIa",
          "x": 24,
          "y": 96,
          "name": "cap",
          "fill": "$text-low",
          "content": "A · PRECEDENCE — THE USER'S OWN NAME ALWAYS WINS; THE LIVE TITLE ONLY FILLS THE SLOT NOBODY CLAIMED",
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
