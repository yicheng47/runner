              ]
            },
            {
              "type": "frame",
              "id": "CXLco",
              "name": "row",
              "width": "fill_container",
              "gap": 12,
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "iuqJZ",
                  "name": "raw",
                  "fill": "$text-mid",
                  "textGrowth": "fixed-width",
                  "width": 320,
                  "content": "cargo test — runner-app",
                  "fontFamily": "$font-mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "bFRUB",
                  "name": "shown",
                  "fill": "$text-hi",
                  "textGrowth": "fixed-width",
                  "width": 344,
                  "content": "cargo test — runner-app",
                  "fontFamily": "$font-ui",
