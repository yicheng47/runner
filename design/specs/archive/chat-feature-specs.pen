                          "geometry": "M24 20.541h-20.572v-3.426h-3.428v-13.715h24v17.14z m-20.572-3.426h17.144v-10.288h-17.144v10.288z m8.573-5.196l-2.425 2.424-2.424-2.424 2.424-2.424 2.425 2.424z m6.857-0.001l-2.424 2.423-2.425-2.423 2.425-2.425 2.424 2.425z",
