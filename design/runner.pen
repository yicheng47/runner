                            {
                              "type": "frame",
                              "id": "D4i1y8",
                              "name": "body",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 8,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "kwbCj",
                                  "name": "h1",
                                  "fill": "$text-1",
                                  "content": "Daily Brief",
                                  "fontFamily": "$font-ui",
                                  "fontSize": 15,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "b8P6G",
                                  "name": "p1",
                                  "fill": "$text-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "The output contract for every trading session brief. The trading-daily skill runs the session; this skill defines what Jason receives. Rules live in trading/system.md — this skill formats, it never defines or amends rules.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-ui",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "kVu2u",
                                  "name": "h2",
                                  "fill": "$text-1",
                                  "content": "When",
                                  "fontFamily": "$font-ui",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "BM0Ei",
                                  "name": "l1",
                                  "fill": "$text-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "•  Pre-open run (~09:00 ET): the FULL 8-section brief.\n•  Post-open run (~10:00 ET): a DELTA brief — fills verified, stop status, what changed since pre-open — plus the action table. Never duplicate the full template an hour later.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-ui",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "sTX58",
                                  "name": "h2b",
                                  "fill": "$text-1",
                                  "content": "The eight sections, fixed order (adopted 2026-08-13, Jason-directed)",
                                  "fontFamily": "$font-ui",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "fmzqO",
                                  "name": "l2",
                                  "fill": "$text-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "1.  Book — positions table, broker-verified: qty, entry, last/pre price, P&L, stop, distance to stop. Never narrative numbers.\n2.  Management — per-position instruction for today: trail / trim / exit / hold, fail lines due, named deadlines.\n3.  Risk — the three books (initial-capital / giveback / gap-stress, system.md §4) as $ and % of equity, plus the capacity line for any armed spec.\n4.  News — macro prints (primary source only; tape reaction is the proxy until verified), roster-attributed moves with catalyst class, explicit \"nothing roster-relevant\" when true.\n5.  Hot tape — pre-market gappers ≥3% and prior-session leaders, each with cause + class.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-ui",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "syoA5",
                                  "name": "h2c",
                                  "fill": "$text-1",
                                  "content": "Action table — the mandatory closer",
                                  "fontFamily": "$font-ui",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "KGn2E",
                                  "name": "p3",
                                  "fill": "$text-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Columns: # | Action | Order / Level | Why | When. One row per action, including explicit no-action rows.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-ui",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
