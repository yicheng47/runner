                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "smFpD",
                          "fill": "#9A9BA5",
                          "content": " model: claude-opus-4-7  ·  /model to change",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "ZuYDQ",
                          "fill": "#5A5C66",
                          "content": " ",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Q0ngw",
                          "fill": "#39E5FF",
                          "content": "▶ help me write a tiny Go http server",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "HWARq",
                          "fill": "#5A5C66",
                          "content": " ",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "E1BDsu",
                          "fill": "#DCDCE0",
                          "content": "⏺ Here's a minimal example. Drop this into main.go:",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "h8OP1X",
                          "fill": "#5A5C66",
                          "content": " ",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Y4Glr4",
                          "fill": "#C792EA",
                          "content": "   package main",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "vuAn4",
                          "fill": "#C792EA",
                          "content": "   import \"net/http\"",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "cjprZ",
                          "fill": "#5A5C66",
                          "content": " ",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "IVydR",
                          "fill": "#82AAFF",
                          "content": "   func main() {",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
