            },
            {
              "type": "text",
              "id": "RhjWX",
              "name": "note",
              "fill": "#B8B9C2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Order — sidebar toggle, Previous page, Next page: the same leading cluster as the Windows header, right after the traffic lights. The rest of the bar stays draggable; a click on a button never starts a drag and double-click still zooms.",
              "lineHeight": 1.35,
              "fontFamily": "Inter",
              "fontSize": 12.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "KQPfj",
              "name": "note",
              "fill": "#B8B9C2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Control — the existing ghost IconButton (Md): 28 px hit target, 14 px lucide chevron-left / chevron-right, 4 px gap. Hover = raised background + text color. Disabled = 0.5 opacity, not-allowed cursor. Everything scales with app zoom.",
              "lineHeight": 1.35,
              "fontFamily": "Inter",
              "fontSize": 12.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "I3Axd",
              "name": "note",
              "fill": "#B8B9C2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Tooltips — “Previous page” and “Next page”, the Windows strings.",
              "lineHeight": 1.35,
              "fontFamily": "Inter",
              "fontSize": 12.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "e4r3X",
              "name": "note",
              "fill": "#B8B9C2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Enabled — Previous is disabled at the start of the window’s page history, Next at its end; both are disabled in Settings and on an empty history.",
              "lineHeight": 1.35,
              "fontFamily": "Inter",
              "fontSize": 12.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "RkQHq",
              "name": "note",
              "fill": "#B8B9C2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Navigation — navigate_runtime_page(−1) / (+1) over visited app pages, the same history the ⌘[ / ⌘] shortcuts use; it does not cycle adjacent tabs. The active terminal regains focus afterwards.",
              "lineHeight": 1.35,
              "fontFamily": "Inter",
              "fontSize": 12.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "rz1XJ",
              "name": "note",
              "fill": "#B8B9C2",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Placement — expanded: the sidebar titlebar. Collapsed: the cluster stays in the window chrome, like the toggle (#246). Fullscreen: the traffic lights hide and the cluster starts 8 px from the left edge. The Windows header is unchanged.",
              "lineHeight": 1.35,
              "fontFamily": "Inter",
              "fontSize": 12.5,
              "fontWeight": "normal"
            }
          ]
        }
      ]
