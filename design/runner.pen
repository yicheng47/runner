                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "zdTgW",
                                  "fill": "#DCDCE0",
                                  "content": "       http.HandleFunc(\"/\", func(w http.ResponseWriter, r *http.Request) {",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "T8aCnR",
                                  "fill": "#DCDCE0",
                                  "content": "           w.Write([]byte(\"hello\\n\"))",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
