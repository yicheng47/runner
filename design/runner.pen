          "fill": "$text-mid",
          "textGrowth": "fixed-width",
          "width": 1000,
          "content": "left · session — icon · title · ⋯ · Stop · ⑂ Fork          right · surface — ⫿ split · ⬓ drawer · ◨ side panel. Every glyph on the right opens or closes a surface; nothing there acts on a session.",
          "fontFamily": "$font-ui",
