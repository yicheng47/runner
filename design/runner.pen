        {
          "type": "text",
          "id": "o7rLL2",
          "x": 24,
          "y": 264,
          "name": "cap_header_clusters",
          "fill": "$text-mid",
          "textGrowth": "fixed-width",
          "width": 1000,
          "content": "left · mission — ⚑ title · ⋯ · Stop / Resume (slots only)          right · surface — ⬓ drawer · ◨ runners rail. Stop's title becomes \"Kill every slot PTY; mission stays running so you can Resume\" — a drawer shell is not a slot and Stop never touches it.",
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
