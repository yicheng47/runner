                                },
                                {
                                  "type": "text",
                                  "id": "nU6tl",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "f54ucJ",
                                  "fill": "#39E5FF",
                                  "content": "▶ help me write a tiny Go http server",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "igfKx",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "UhxRK",
                                  "fill": "#DCDCE0",
                                  "content": "⏺ Here's a minimal example. Drop this into main.go:",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "T60IEx",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "I9Cutg",
                                  "fill": "#C792EA",
                                  "content": "   package main",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "J6JVm",
                                  "fill": "#C792EA",
                                  "content": "   import \"net/http\"",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "PTfvk",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "J5AlrL",
                                  "fill": "#82AAFF",
                                  "content": "   func main() {",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "sSZIr",
                                  "fill": "#DCDCE0",
                                  "content": "       http.HandleFunc(\"/\", func(w http.ResponseWriter, r *http.Request) {",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "UJYcG",
                                  "fill": "#DCDCE0",
                                  "content": "           w.Write([]byte(\"hello\\n\"))",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "F6Txz",
                                  "fill": "#DCDCE0",
                                  "content": "       })",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "y3E87j",
                                  "fill": "#DCDCE0",
                                  "content": "       http.ListenAndServe(\":8080\", nil)",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "mJITy",
                                  "fill": "#82AAFF",
