                                },
                                {
                                  "type": "text",
                                  "id": "KLgxr",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "T7PuW",
                                  "fill": "#39E5FF",
                                  "content": "▶ help me write a tiny Go http server",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "N7h2y",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "jzdzr",
                                  "fill": "#DCDCE0",
                                  "content": "⏺ Here's a minimal example. Drop this into main.go:",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "YLCZ1",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "xjJZv",
                                  "fill": "#C792EA",
                                  "content": "   package main",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "l9BGO",
                                  "fill": "#C792EA",
                                  "content": "   import \"net/http\"",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "ZPCuM",
                                  "fill": "#5A5C66",
                                  "content": " ",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "OFrNc",
                                  "fill": "#82AAFF",
                                  "content": "   func main() {",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 12,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "gA6J4",
